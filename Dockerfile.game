# syntax=docker/dockerfile:1.7

FROM python:3.11-slim AS dependencies

WORKDIR /app
COPY --from=game /requirements.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

# Локально код приходит bind mount-ом из ../games/<game>.
FROM dependencies AS dev
ENV PYTHONUNBUFFERED=1 \
    GAME_PORT=8080 \
    GAME_MODULE=server
CMD ["sh", "-c", "python -c \"import os, importlib; m = importlib.import_module(os.environ.get('GAME_MODULE','server')); m.app.run(host='0.0.0.0', port=int(os.environ.get('GAME_PORT','8080')))\""]

# Серверный target: исходники копируются в образ, процесс работает без root.
FROM dependencies AS final
RUN useradd --create-home --uid 10001 game \
    && mkdir -p /app/db \
    && chown game:game /app/db
COPY --from=game --chown=game:game / /app
ENV PYTHONUNBUFFERED=1 \
    GAME_PORT=8080 \
    GAME_MODULE=server
USER game
CMD ["sh", "-c", "python -c \"import os, importlib; m = importlib.import_module(os.environ.get('GAME_MODULE','server')); m.app.run(host='0.0.0.0', port=int(os.environ.get('GAME_PORT','8080')))\""]
