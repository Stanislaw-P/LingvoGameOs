@model UserViewModel

@{
    ViewData["Title"] = $"{SharedLocalizer["user_profile"].Value} {Model.Name} {Model.Surname}";
}

<link rel="stylesheet" href="/css/modal-windows.css" />

<div class="content__row">
    <aside class="content__sidebar">
        <!-- Профиль пользователя -->
        <div class="profile">
            <h3 class="profile__title">@SharedLocalizer["user_profile"]</h3>
            <div class="profile__avatar">
                <div class="profile__avatar-wrapper">
                    <img src="@Model.AvatarImgPath" alt="@SharedLocalizer["avatar"]" class="profile__image">
                </div>
            </div>
            <form class="profile__form">
                <div class="profile__field">
                    <label class="profile__label" for="firstName">@SharedLocalizer["first_name"]</label>
                    <input type="text" class="profile__input" id="firstName" value="@Model.Name" disabled>
                </div>
                <div class="profile__field">
                    <label class="profile__label" for="lastName">@SharedLocalizer["last_name"]</label>
                    <input type="text" class="profile__input" id="lastName" value="@Model.Surname" disabled>
                </div>
                @if (Model.IsMyProfile)
                {
                    <div class="profile__field">
                        <label class="profile__label" for="email">Email</label>
                        <input type="email" class="profile__input" id="email" value="@Model.UserName" disabled>
                    </div>
                }
                <div class="profile__field">
                    <label class="profile__label" for="level">@SharedLocalizer["total_score"]</label>
                    <input type="text" class="profile__input" id="level" value="@Model.TotalPoints" disabled>
                </div>
                <div class="profile__field profile__field--bio">
                    <label class="profile__label" for="bio">@SharedLocalizer["about_me"]</label>
                    <textarea class="profile__input profile__textarea" id="bio" placeholder="@SharedLocalizer["tell_about_yourself"]" disabled>@Model.Description</textarea>
                </div>
                @if (Model.IsMyProfile)
                {
                        @if (!Model.IsEmailConfirmed)
                        {
                            <p>@SharedLocalizer["email_not_verified"]</p>
                            <a asp-controller="Account" asp-action="ConfirmEmail" data-tooltip="@SecondLocalizer["verify"]">@SharedLocalizer["verify"]</a>
                        }
                    <a type="button" class="profile__button" asp-controller="Profile" asp-action="Settings" asp-route-userId="@Model.Id" data-tooltip="@SecondLocalizer["profile_edit_action"]">
                        @SharedLocalizer["profile_edit_action"]
                    </a>
                }
            </form>
        </div>
    </aside>
    <section class="content__main">
        <!-- Блок добавленных пользователем игр -->
        <div class="games-block">
            <!-- Блок добавленных пользователем игр -->
            <section class="user-added-games">
                <header class="user-added-games__header">
                    <h3 class="user-added-games__title">@SharedLocalizer["created_games"]</h3>
                    <div class="user-added-games__controls">
                        @if (Model.IsMyProfile)
                        {
                            <a type="button" class="user-added-games__upload-button" asp-controller="Game" asp-action="Upload" data-tooltip="@SecondLocalizer["upload_game_button"]">@SharedLocalizer["upload_game_button"]</a>
                        }
                        @if (Model.DevGames != null && Model.DevGames.Any())
                        {
                            <div class="carousel-controls">
                                <button class="carousel-control carousel-control--prev user-added-games__prev" aria-label="@SharedLocalizer["previous_games"]">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="15 18 9 12 15 6"></polyline>
                                    </svg>
                                </button>
                                <span class="carousel-page-counter user-added-games__page-counter">@SharedLocalizer["pagination_one_of_one"]</span>
                                <button class="carousel-control carousel-control--next user-added-games__next" aria-label="@SharedLocalizer["next_games"]">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="9 18 15 12 9 6"></polyline>
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                </header>
                @if ((Model.DevGames != null && Model.DevGames.Any()) || (Model.DevPendingGames != null && Model.DevPendingGames.Any()))
                {
                    <div class="user-added-games__carousel">
                        <div class="user-added-games__list">
                            @foreach (var game in Model.DevGames!)
                            {
                                <article class="user-added-games__item">
                                    <a asp-area="" asp-controller="Game" asp-action="Details" asp-route-idGame="@game.Id" class="user-added-games__link">
                                        <img src="@(game.CoverImagePath ?? "/img/default-game.png")" alt="@SharedLocalizer["field_game_cover"] @game.Title" class="user-added-games__image" loading="lazy">
                                        @if (!game.IsActive && Model.IsMyProfile)
                                        {
                                            <div class="inactive-game-card__status">@SharedLocalizer["status_inactive"]</div>
                                        }
                                        <div class="user-added-games__content">
                                            <h4 class="user-added-games__name">@game.Title</h4>
                                            <div class="user-added-games__stats">
                                                <span class="user-added-games__rating">
                                                    <img src="/icon/shape.svg" alt="star" class="rating-star"> @game.AverageRaitingPlayers
                                                </span>
                                                <span class="user-added-games__likes">
                                                    <img src="/icon/like2.svg" alt="like" class="stat-icon"> @game.FavoritesCount
                                                </span>
                                                @* <span class="user-added-games__views">
                                                    <img src="/icon/eye.svg" alt="view" class="stat-icon"> 130
                                                </span> *@
                                            </div>
                                        </div>
                                    </a>
                                    <div class="user-added-games__actions">
                                        @if (game?.GamePlatform?.Name == "Desktop")
                                        {
                                            <a role="button" href="@game.GameFilePath" download class="user-added-games__button download-btn" data-tooltip="@SecondLocalizer["download"]">@SharedLocalizer["download"]</a>
                                        }
                                        else
                                        {
                                            <a role="button" asp-area="" asp-controller="Game" asp-action="Start" asp-route-idGame="@game.Id" class="user-added-games__button" data-tooltip="@SecondLocalizer["play"]">@SharedLocalizer["play"]</a>
                                        }
                                        @if (Model.IsMyProfile)
                                        {
                                            <a href="#" onclick="alert('@SharedLocalizer["feature_in_development"] @SharedLocalizer["apologize_temporary_inconvenience"]')" class="user-added-games__button user-added-games__button--secondary" data-tooltip="@SecondLocalizer["analytics"]">@SharedLocalizer["analytics"]</a>
                                            <a asp-area="Developer" asp-controller="Game" asp-action="Edit" asp-route-gameId="@game.Id" class="user-added-games__button user-added-games__button--icon" title="@SharedLocalizer["action_edit"]">
                                                <img src="/icon/edit.svg" alt="@SharedLocalizer["action_edit"]" class="user-added-games__edit-icon">
                                            </a>
                                        }
                                    </div>
                                </article>
                            }
                            @if (Model.IsMyProfile)
                            {
                                @foreach (var pendingGame in Model.DevPendingGames!)
                                {
                                    <article class="user-added-games__item">
                                        <div class="user-added-games__link">
                                            <img src="@(pendingGame.CoverImagePath ?? "/img/default-game.png")" alt="@SharedLocalizer["field_game_cover"] @pendingGame.Title" class="user-added-games__image" loading="lazy">
                                            <div class="pending-game-card__status">@SharedLocalizer["status_under_moderation"]</div>
                                            <div class="user-added-games__content">
                                                <h4 class="user-added-games__name">@pendingGame.Title</h4>
                                            </div>
                                        </div>
                                        <div class="user-added-games__actions">
                                            @if (pendingGame?.GamePlatform?.Name == "Desktop")
                                            {
                                                <a role="button" href="@pendingGame.GameFilePath" download class="user-added-games__button" data-tooltip="@SecondLocalizer["download"]">@SharedLocalizer["download"]</a>
                                            }
                                            else
                                            {
                                                <button disabled class="user-added-games__button" data-tooltip="@SecondLocalizer["status_under_moderation"]">@SharedLocalizer["status_under_moderation"]</button>
                                            }
                                            @if (Model.IsMyProfile)
                                            {
                                                <a href="#" onclick="alert('@SharedLocalizer["feature_in_development"] @SharedLocalizer["moderation_feedback_email"]')" class="user-added-games__button user-added-games__button--secondary" data-tooltip="@SecondLocalizer["feedback"]">@SharedLocalizer["feedback"]</a>
                                                <a asp-area="Developer" asp-controller="PendingGame" asp-action="Edit" asp-route-pendingGameId="@pendingGame?.Id" class="user-added-games__button user-added-games__button--icon" title="@SharedLocalizer["action_edit"]">
                                                    <img src="/icon/edit.svg" alt="@SharedLocalizer["action_edit"]" class="user-added-games__edit-icon">
                                                </a>
                                            }
                                        </div>
                                    </article>
                                }
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="user-added-games__empty">
                        <p class="user-added-games__empty-text">@SharedLocalizer["create_first_game_promo"]</p>
                        @if (User.IsInRole(Constants.DevRoleName))
                        {
                            <a type="button" asp-area="" asp-controller="Game" asp-action="Upload" class="user-added-games__upload-button" data-tooltip="@SecondLocalizer["create_game"]">@SharedLocalizer["create_game"]</a>
                        }
                    </div>
                }
            </section>

            <!-- Recent Games Block -->
            <section class="recent-games">
                <header class="recent-games__header">
                    <h3 class="recent-games__title">@SharedLocalizer["game_history"]</h3>
                    <div class="recent-games__controls">
                        <a href="#" class="recent-games__view-all-button" data-tooltip="@SecondLocalizer["view_all"]">@SharedLocalizer["view_all"]</a>

                        @if (Model.GamesHistory != null && Model.GamesHistory.Any())
                        {
                            <div class="carousel-controls">
                                <button class="carousel-control carousel-control--prev recent-games__prev" aria-label="@SharedLocalizer["previous_games"]">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="15 18 9 12 15 6"></polyline>
                                    </svg>
                                </button>
                                <span class="carousel-page-counter recent-games__page-counter">@SharedLocalizer["pagination_one_of_one"]</span>
                                <button class="carousel-control carousel-control--next recent-games__next" aria-label="@SharedLocalizer["next_games"]">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="9 18 15 12 9 6"></polyline>
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                </header>
                @if (Model.GamesHistory != null && Model.GamesHistory.Any())
                {
                    <div class="recent-games__carousel">
                        <div class="recent-games__list">
                            @foreach (var game in Model.GamesHistory)
                            {
                                <article class="recent-games__item">
                                    <a asp-area="" asp-controller="Game" asp-action="Details" asp-route-idGame="@game.Id" class="recent-games__link">
                                        <img src="@game.CoverImagePath" alt="@SharedLocalizer["field_game_cover"] @game.Title" class="recent-games__image" loading="lazy">
                                        <div class="recent-games__content">
                                            <h4 class="recent-games__name">@game.Title</h4>
                                            <p class="recent-games__description">@game.Description</p>
                                            <p class="recent-games__score">Баллы: 0</p>
                                        </div>
                                    </a>
                                </article>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="recent-games__empty">
                        <p class="recent-games__empty-text">@SharedLocalizer["discover_new_games"]</p>
                        <a href="/" class="recent-games__button" data-tooltip="@SecondLocalizer["find_games"]">@SharedLocalizer["find_games"]</a>
                    </div>
                }
            </section>
        </div>
    </section>
</div>

<!-- Modal for editing profile -->
<div class="custom-modal" id="edit-profile-modal">
    <div class="modal__content">
        <button class="modal__close" id="close-edit-modal" aria-label="@SharedLocalizer["close_modal_window"]">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        <h2 class="modal__title">@SharedLocalizer["profile_modal_edit_title"]</h2>
        <form class="modal__form" id="edit-profile-form" enctype="multipart/form-data">
            <div class="modal__field">
                <label class="modal__label" for="modal-avatar">@SharedLocalizer["avatar"]</label>
                <div class="modal__avatar-wrapper">
                    <img src="@(Model.AvatarImgPath ?? "/img/avatar100.png")" alt="@SharedLocalizer["avatar"]" class="modal__avatar-image" id="modal-avatar-preview">
                    <input type="file" class="modal__avatar-input" id="modal-avatar" accept="image/*">
                    <label for="modal-avatar" class="modal__upload-button">@SharedLocalizer["upload_new_photo"]</label>
                </div>
            </div>
            <div class="modal__field">
                <label class="modal__label" for="modal-firstName">@SharedLocalizer["first_name"]</label>
                <input type="text" class="modal__input" id="modal-firstName" value="@Model.Name" required>
            </div>
            <div class="modal__field">
                <label class="modal__label" for="modal-lastName">@SharedLocalizer["last_name"]</label>
                <input type="text" class="modal__input" id="modal-lastName" value="@Model.Surname" required>
            </div>
            <div class="modal__field">
                <label class="modal__label" for="modal-email">Email</label>
                <input type="email" class="modal__input" id="modal-email" value="@Model.UserName" required>
            </div>
            <div class="modal__field">
                <label class="modal__label" for="modal-bio">@SharedLocalizer["about_me"]</label>
                <textarea class="modal__input modal__textarea" id="modal-bio" placeholder="@SharedLocalizer["tell_about_yourself"]">@Model.Description</textarea>
            </div>
            <div class="modal__actions">
                <button type="button" class="modal__button modal__button--secondary" id="cancel-edit" data-tooltip="@SecondLocalizer["action_cancel"]">@SharedLocalizer["action_cancel"]</button>
                <button type="submit" class="modal__button modal__button--primary" id="save-profile" data-tooltip="@SecondLocalizer["action_save"]">@SharedLocalizer["action_save"]</button>
            </div>
            <div class="modal__error" id="modal-error" style="display: none;"></div>
        </form>
    </div>
</div>

<!-- Модальное окно подтверждения скачивания -->
<div id="downloadModal" class="modal download-modal" style="display: none;">
    <div class="modal__content download-modal__content">
        <button class="modal__close download-modal__close" type="button">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>

        <div class="download-modal__header">
            <h3 class="download-modal__title">@SharedLocalizer["download_confirmation_title"]</h3>
        </div>

        <div class="download-modal__body">
            <div class="download-modal__icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21 15V19C21 19.5304 20.7893 20.0391 20.4142 20.4142C20.0391 20.7893 19.5304 21 19 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V15" stroke="var(--accent-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M7 10L12 15L17 10" stroke="var(--accent-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M12 15V3" stroke="var(--accent-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <p class="download-modal__message">@SharedLocalizer["download_desktop_only_warning"]</p>
        </div>

        <div class="download-modal__footer">
            <button type="button" class="download-modal__cancel games__preview" data-tooltip="@SecondLocalizer["action_cancel"]">@SharedLocalizer["action_cancel"]</button>
            <button type="button" class="download-modal__confirm games__button" data-tooltip="@SecondLocalizer["download"]">@SharedLocalizer["download"]</button>
        </div>
    </div>
</div>

@* <script type="module" src="/js/script.js"></script> *@
<script src="/js/download-handler.js"></script>