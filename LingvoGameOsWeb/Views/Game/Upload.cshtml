@model AddGameViewModel

@{
    ViewData["Title"] = SharedLocalizer["upload_game_page_title"].Value;
}

<link rel="stylesheet" href="~/css/game-valdate.css" asp-append-version="true">

<div class="wrapper">
    <div id="header-placeholder"></div>
    <main class="content">
        <div class="content__container _container">
            <section class="upload-hero" data-game-id="upload">
                <div class="upload-hero__content">
                    <h1 class="upload-hero__title">@SharedLocalizer["upload_game_button"]</h1>
                    <div class="upload-hero__form-container">
                        <p class="upload-hero__info">
                            <a href="/Home/NewsForDevelopers" class="upload-hero__info--highlight" data-tooltip="@SecondLocalizer["dev_read_docs_notice"]">
                                @SharedLocalizer["dev_read_docs_notice"]
                            </a>
                        </p>
                        <form method="post" class="upload-form" id="upload-game-form" data-action="/game/upload" enctype="multipart/form-data">

                            <div id="validation-summary" class="validation-summary" style="display: none;">
                                <div class="validation-summary__header">
                                    <h4>@SharedLocalizer["form_fix_errors_prompt"]</h4>
                                </div>
                                <ul id="validation-errors-list" class="validation-summary__errors"></ul>
                            </div>

                            <div class="upload-form__group">
                                <label for="game-title" class="upload-form__label">
                                    @SharedLocalizer["field_game_title"] <span class="required">*</span>
                                </label>
                                <div class="upload-form__input-wrapper">
                                    <div class="input-field">
                                        <input type="text" asp-for="Title" id="game-title" class="input-field__input"
                                               placeholder="@SharedLocalizer["field_game_title_placeholder"]" required>
                                    </div>
                                    <span asp-validation-for="Title" class="error-message"></span>
                                </div>
                            </div>

                            <div class="upload-form__group">
                                <label for="game-short-description" class="upload-form__label">
                                    @SharedLocalizer["field_game_short_description"] <span class="required">*</span>
                                </label>
                                <div class="upload-form__input-wrapper">
                                    <div class="input-field input-field--textarea">
                                        <textarea asp-for="Description" id="game-short-description"
                                                  class="input-field__textarea"
                                                  placeholder="@SharedLocalizer["field_game_short_description_placeholder"]" maxlength="200"
                                                  required></textarea>
                                    </div>
                                    <span asp-validation-for="Description" class="error-message"></span>
                                </div>
                            </div>

                            <div class="upload-form__group">
                                <label for="game-rules" class="upload-form__label">
                                    @SharedLocalizer["field_game_rules"] <span class="required">*</span>
                                </label>
                                <div class="upload-form__input-wrapper">
                                    <div class="input-field input-field--textarea">
                                        <textarea asp-for="Rules" id="game-rules" class="input-field__textarea"
                                                  placeholder="@SharedLocalizer["field_game_rules_placeholder"]" required></textarea>
                                    </div>
                                    <span asp-validation-for="Rules" class="error-message"></span>
                                </div>
                            </div>

                            <div class="upload-form__group">
                                <label for="game-platform" class="upload-form__label">
                                    @SharedLocalizer["filter_platform"] <span class="required">*</span>
                                </label>
                                <div class="upload-form__input-wrapper" data-tooltip="@SecondLocalizer["field_game_platform_label"]">
                                    <div class="custom-dropdown" id="platform-dropdown">
                                        <input type="hidden" asp-for="GamePlatform" id="game-platform" required>
                                        <div class="custom-dropdown__selected" tabindex="0" role="combobox" aria-expanded="false" aria-label="@SharedLocalizer["field_game_platform_placeholder"]">
                                            <span class="custom-dropdown__placeholder">@SharedLocalizer["field_game_platform_placeholder"]</span>
                                            <img src="/icon/chevron-down.svg" alt="Открыть список" class="custom-dropdown__icon">
                                        </div>
                                        <div class="custom-dropdown__menu" role="listbox" aria-hidden="true">
                                            <ul class="custom-dropdown__options">
                                                <li class="custom-dropdown__option" role="option" data-value="Web-Mobile" aria-selected="false">Web-Mobile</li>
                                                <li class="custom-dropdown__option" role="option" data-value="Web-Desktop" aria-selected="false">Web-Desktop</li>
                                                <li class="custom-dropdown__option" role="option" data-value="Desktop" aria-selected="false">Desktop</li>
                                            </ul>
                                        </div>
                                        <div class="selected-platforms-list" id="selected-platforms-list"></div>
                                    </div>
                                    <span asp-validation-for="GamePlatform" class="error-message"></span>
                                </div>
                            </div>

                            <div class="upload-form__group" id="game-file-upload-group" style="display: none;">
                                <label class="upload-form__label">@SharedLocalizer["field_game_file"] <span class="required">*</span></label>
                                <div class="upload-form__input-wrapper">
                                    <div class="upload-form__file-upload">
                                        <label class="file-upload" id="file-dropzone">
                                            <div class="file-upload__dropzone">
                                                <div class="file-upload__text">
                                                    <img src="/icon/cloud-download.svg" alt="" class="file-upload__icon">
                                                    <div class="file-upload__info">
                                                        <p class="file-upload__info-text">
                                                            @SharedLocalizer["field_game_file_dropzone"]
                                                        </p>
                                                        <p class="file-upload__size">@SharedLocalizer["field_game_file_max_size_2gb"]</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </label>
                                        <input type="file" asp-for="UploadedGameFile" id="game-file-file"
                                               class="input-field__input"
                                               accept=".msi" hidden>
                                        <div class="file-upload__previews" id="file-preview"></div>
                                    </div>
                                    <span id="file-error" class="error-message"></span>
                                </div>
                            </div>

                            <div class="upload-form__group">
                                <label for="game-skillsLearning" class="upload-form__label">
                                    @SharedLocalizer["game_developed_skills"] <span class="required">*</span>
                                </label>
                                <div class="upload-form__input-wrapper" data-tooltip="@SecondLocalizer["field_skills_prompt"]">
                                    <div class="custom-dropdown" id="skillsLearning-dropdown">
                                        <div class="custom-dropdown__selected" tabindex="0" role="combobox" aria-expanded="false" aria-label="@SharedLocalizer["field_skills_placeholder"]">
                                            <span class="custom-dropdown__placeholder">@SharedLocalizer["field_skills_placeholder"]</span>
                                            <img src="/icon/chevron-down.svg" alt="Открыть список" class="custom-dropdown__icon">
                                        </div>
                                        <div class="custom-dropdown__menu" role="listbox" aria-hidden="true">
                                            <input type="text" class="custom-dropdown__search" placeholder="@SharedLocalizer["search_skills_placeholder"]" aria-label="@SharedLocalizer["search_skills_placeholder"]">
                                            <ul class="custom-dropdown__options">
                                                <li class="custom-dropdown__option" data-value="select-all" role="option" aria-selected="false">@SharedLocalizer["action_select_all"]</li>
                                                @foreach (var skill in ViewBag.SkillsLearning)
                                                {
                                                    <li class="custom-dropdown__option" data-value="@skill" role="option" aria-selected="false">@skill</li>
                                                }
                                            </ul>
                                        </div>
                                        <div class="selected-skillsLearning-list" id="selected-skillsLearning-list"></div>
                                        <input asp-for="SkillsLearning" type="hidden" id="game-skillsLearning" name="skillsLearning" required>
                                    </div>
                                    <span id="skillsLearning-error" class="error-message"></span>
                                </div>
                            </div>


                            <div class="upload-form__group">
                                <label class="upload-form__label">@SharedLocalizer["field_level"] <span class="required">*</span></label>
                                <div class="upload-form__input-wrapper">
                                    <div class="level-list">
                                        <label class="level-item">
                                            <span class="level-item__input">
                                                <input type="radio" asp-for="LanguageLevel" value="Барашек, который пытается говорить"
                                                       class="level-item__radio" required>
                                            </span>
                                            <span class="level-item__text">
                                                @SharedLocalizer["level_lamb_desc"]
                                            </span>
                                        </label>
                                        <label class="level-item">
                                            <span class="level-item__input">
                                                <input type="radio" asp-for="LanguageLevel" value="Юный нарт"
                                                       class="level-item__radio">
                                            </span>
                                            <span class="level-item__text">
                                                @SharedLocalizer["level_young_nart_desc"]
                                            </span>
                                        </label>
                                        <label class="level-item">
                                            <span class="level-item__input">
                                                <input type="radio" asp-for="LanguageLevel" value="Кавказский орёл"
                                                       class="level-item__radio">
                                            </span>
                                            <span class="level-item__text">
                                                @SharedLocalizer["level_caucasian_eagle_desc"]
                                            </span>
                                        </label>
                                        <label class="level-item">
                                            <span class="level-item__input">
                                                <input type="radio" asp-for="LanguageLevel" value="Старейшина, который говорит тосты"
                                                       class="level-item__radio">
                                            </span>
                                            <span class="level-item__text">
                                                @SharedLocalizer["level_elder_toast_desc"]
                                            </span>
                                        </label>
                                        <label class="level-item">
                                            <span class="level-item__input">
                                                <input type="radio" asp-for="LanguageLevel" value="Хранитель языка"
                                                       class="level-item__radio">
                                            </span>
                                            <span class="level-item__text">
                                                @SharedLocalizer["level_keeper_of_language_desc"]
                                            </span>
                                        </label>
                                    </div>
                                    <span asp-validation-for="LanguageLevel" class="error-message"></span>
                                </div>
                            </div>

                            <div class="upload-form__group">
                                <label class="upload-form__label">
                                    @SharedLocalizer["field_github_repo_link"] <span class="required">*</span>
                                </label>
                                <div class="upload-form__input-wrapper">
                                    <div class="input-field">
                                        <input type="text" asp-for="GameGitHubUrl" class="input-field__input"
                                               placeholder="Введите URL на GitHub" required>
                                    </div>
                                    <span asp-validation-for="GameGitHubUrl" class="error-message"></span>
                                </div>
                            </div>

                            

                            <div class="upload-form__group">
                                <label for="game-cover-url" class="upload-form__label">
                                    @SharedLocalizer["field_game_cover"] <span class="required">*</span>
                                </label>

                                <p class="upload-form__file-label">@SharedLocalizer["field_game_cover_hint"]</p>
                                <div class="upload-form__file-upload">
                                    <div class="file-upload" id="cover-dropzone">
                                        <div class="file-upload__dropzone">
                                            <div class="file-upload__text">
                                                <img src="/icon/cloud-download.svg" alt="" class="file-upload__icon">
                                                <div class="file-upload__info">
                                                    <p class="file-upload__info-text">
                                                        @SharedLocalizer["dropzone_upload_or_drag_file"]
                                                    </p>
                                                    <p class="file-upload__size">@SharedLocalizer["field_cover_max_size_30mb"]</p>
                                                </div>
                                            </div>
                                            <input type="file" asp-for="CoverImage" id="game-cover-file" name="CoverImage"
                                                   class="input-field__input" accept=".jpg,.jpeg,.png,.webp" hidden>
                                        </div>
                                    </div>
                                    <div class="file-upload__previews" id="cover-preview"></div>
                                </div>
                                <span id="cover-error" class="error-message"></span>
                            </div>

                            <div class="upload-form__group">
                                <label for="game-video" class="upload-form__label">
                                    @SharedLocalizer["field_vk_video_link"]
                                </label>
                                <p class="upload-form__file-label">@SharedLocalizer["field_video_hint"]</p>
                                <div class="upload-form__input-wrapper">
                                    <div class="input-field">
                                        <input type="url" asp-for="VideoUrl" id="game-video" class="input-field__input"
                                               placeholder="@SharedLocalizer["field_video_url_placeholder"]">
                                    </div>
                                </div>
                            </div>

                            <div class="upload-form__group">
                                <label for="game-video" class="upload-form__label">
                                    @SharedLocalizer["field_game_screenshots"] <span class="required">*</span>
                                </label>
                                <p class="upload-form__file-label">@SharedLocalizer["field_screenshots_hint"]</p>
                                <div class="upload-form__file-upload">
                                    <label class="file-upload" id="screenshots-dropzone" for="game-screenshots-file">
                                        <div class="file-upload__dropzone">
                                            <div class="file-upload__text">
                                                <img src="/icon/cloud-download.svg" alt="Загрузите изображения" class="file-upload__icon">
                                                <div class="file-upload__info">
                                                    <p class="file-upload__info-text">
                                                        @SharedLocalizer["dropzone_upload_or_drag_files"]
                                                    </p>
                                                    <p class="file-upload__size">@SharedLocalizer["field_cover_max_size_30mb"]</p>
                                                </div>
                                            </div>
                                        </div>
                                    </label>
                                    <input type="file" asp-for="UploadedImages" id="game-screenshots-file" name="UploadedImages"
                                           class="input-field__input" accept=".jpg,.jpeg,.png,.webp" multiple
                                           hidden>
                                    <div class="file-upload__previews" id="screenshots-preview"></div>
                                </div>
                                <span id="screenshots-error" class="error-message"></span>
                            </div>

                            <button type="submit" asp-controller="Upload" asp-action="Index" class="upload-form__submit" aria-busy="false" data-tooltip="@SecondLocalizer["action_publish_game"]">
                                <span class="upload-form__submit-text">@SharedLocalizer["action_publish_game"]</span>
                            </button>
                        </form>
                    </div>
                </div>
            </section>
        </div>
    </main>
</div>

<div id="notification"></div>

@section Scripts {
    <script type="module" src="/js/upload.js"></script>
}