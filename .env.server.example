# Скопируй в .env и заполни. Пустые обязательные значения остановят
# docker compose до запуска контейнеров.
ASPNETCORE_ENVIRONMENT=Production
SITE_PUBLIC_HOST=
PORTAL_PUBLIC_URL=
SITE_IP=127.0.0.1
SITE_PORT=8080
API_PORT=8081
IMAGE_TAG=server
# Offline server stores new uploads locally in a persistent Docker volume.
FILE_STORAGE=local
OFFLINE_MODE=true

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_DATA_PATH=./postgres-db

ADMIN_USER_PASSWORD=
DEVELOPER_USER_PASSWORD=
GAMES_API_SECRET=
GAMES_FLASK_SECRET=
# Папка с семью игровыми сабмодулями внутри LingvoGameOs.
GAMES_SOURCE_PATH=./games

EMAIL_PASSWORD=
VKID_CLIENT_ID=
VKID_CLIENT_SECRET=

# Необязательно: Timeweb S3 при FILE_STORAGE=auto вместо local.
AWS_TIMEWEB_KEY_ID=
AWS_TIMEWEB_KEY=
AWS_TIMEWEB_BUCKET_NAME=
AWS_TIMEWEB_SERVICE_URL=

# Оставлено для совместимости с Development/Test окружениями.
AWS_YANDEX_KEY_ID=
AWS_YANDEX_KEY=
AWS_YANDEX_BUCKET_NAME=
AWS_YANDEX_SERVICE_URL=
